      "isDeleted": false,
      "boundElements": [],
      "updated": 1788271347307,
      "link": null,
      "locked": false,
      "text": "Why would you do this:\n- a partial list\n\n- temporal coupling\n    - different rates of change\n\n- They don't have to be all\nthe same platform/language etc. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why would you do this:\n- a partial list\n\n- temporal coupling\n    - different rates of change\n\n- They don't have to be all\nthe same platform/language etc. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
