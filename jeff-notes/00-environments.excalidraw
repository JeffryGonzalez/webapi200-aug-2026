      "isDeleted": false,
      "boundElements": null,
      "updated": 1788193045436,
      "link": null,
      "locked": false,
      "text": "you need to cast\nSOMETHING\nin the role of \nenvironment orchestrator\n\n- Aspire",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "you need to cast\nSOMETHING\nin the role of \nenvironment orchestrator\n\n- Aspire",
      "autoResize": true,
      "lineHeight": 1.25
